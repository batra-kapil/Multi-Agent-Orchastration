<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <label>Verify Employee OTP</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <variables>
        <name>entered_otp</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>is_verified</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <decisions>
        <name>Check_OTP</name>
        <label>Check OTP</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnector>
            <targetReference>Set_Verified_False</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>OTP_Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>entered_otp</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>123456</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Verified_True</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>

    <assignments>
        <name>Set_Verified_True</name>
        <label>Set Verified True</label>
        <locationX>50</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>is_verified</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Verified_False</name>
        <label>Set Verified False</label>
        <locationX>300</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>is_verified</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Check_OTP</targetReference>
        </connector>
    </start>
</Flow>
